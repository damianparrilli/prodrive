    }
    
    .elfsight-app-39769996-97d8-4f8d-b2af-0aff03cb9eae .eapps-widget-toolbar,
    .eapps-widget-toolbar,
    div[class*="eapps-widget-toolbar"],
    .eapps-instagram-feed-footer,
    div[class*="eapps-instagram-feed-footer"] {
        display: none !important;
        opacity: 0 !important;
        visibility: hidden !important;
        height: 0 !important;
        overflow: hidden !important;
    }
</style>

<script is:inline>
    (function() {
        function hideElfsightBranding() {
            const brandingSelectors = [
                '.elfsight-app-39769996-97d8-4f8d-b2af-0aff03cb9eae a[title="Free Instagram Feed Widget"]',
                '.elfsight-app-39769996-97d8-4f8d-b2af-0aff03cb9eae a[href*="elfsight.com"]',
                'a[title="Free Instagram Feed Widget"]',
                'a[href*="elfsight.com"][target="_blank"]',
                '.eapps-widget-toolbar',
                'div[class*="eapps-widget-toolbar"]',
                '.eapps-instagram-feed-footer',
                'div[class*="eapps-instagram-feed-footer"]'
            ];
            
            brandingSelectors.forEach(selector => {
                const elements = document.querySelectorAll(selector);
                elements.forEach(el => {
                    if (!el.closest('.elfsight-app-39769996-97d8-4f8d-b2af-0aff03cb9eae') || 
                        el.matches('a[href*="elfsight.com"]') || 
                        el.matches('a[title="Free Instagram Feed Widget"]') ||
                        el.classList.contains('eapps-widget-toolbar') ||
                        el.classList.contains('eapps-instagram-feed-footer')) {
                        el.style.cssText = 'display: none !important; opacity: 0 !important; visibility: hidden !important; pointer-events: none !important; height: 0 !important; width: 0 !important; overflow: hidden !important;';
                    }
                });
            });
        }
        
        hideElfsightBranding();
        
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', hideElfsightBranding);
        }
        
        const observer = new MutationObserver(hideElfsightBranding);
        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
        
        setInterval(hideElfsightBranding, 300);
        setTimeout(hideElfsightBranding, 1500);
        setTimeout(hideElfsightBranding, 3000);
    })();
</script>