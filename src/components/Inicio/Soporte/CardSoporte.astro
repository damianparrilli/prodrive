---
import { Image } from "astro:assets";

import teamviewerImage from "../../../assets/images/teamviwer.png";
import anydeskImage from "../../../assets/images/anydesk.png";
import salvavidasImage from "../../../assets/images/salvavidas.png";

interface Props {
  urlImg?: string;
  titulo: string;
  descripcion: string;
  linkDescarga?: string;
  linkAnchor: string;
  descargar?: string;
  ticket?: boolean;
  class?: string;
}

const {
  titulo,
  descripcion,
  urlImg,
  descargar,
  ticket,
  linkDescarga,
  linkAnchor,
  class: className,
} = Astro.props;

const imageMap: Record<string, any> = {
  teamviwer: teamviewerImage,
  anydesk: anydeskImage,
};
---

<div
  class={`flex flex-col bg-[#28243C] max-md:max-w-[600px] w-full md:w-1/2 text-left py-8 px-6 md:px-8 rounded-4xl gap-3 ${className || ''}`}
>
  {
    urlImg ? (
      <Image
        src={imageMap[urlImg]}
        alt={`Logo de ${titulo}`}
        width={urlImg === "anydesk" ? 400 : 500}
        height={urlImg === "anydesk" ? 133 : 200}
        class={`object-contain logo-soporte ${urlImg === "anydesk" ? "logo-anydesk" : "logo-teamviewer"}`}
        style="width: auto; max-width: fit-content; display: block;"
        loading="eager"
        decoding="async"
        quality={100}
      />
    ) : (
      ""
    )
  }

<div class="flex items-center gap-3">
    {ticket && <Image
        src={salvavidasImage}
        alt={`Logo de ${titulo}`}
        width={200}
        height={200}
        class={`object-contain w-max ${urlImg === "anydesk" ? "h-7" : "h-10"}`}
        loading="eager"
        decoding="async"
        format="webp"
      />}
    <h3 class="text-2xl"> {titulo}</h3>
</div>
  
  <p class="mb-4 text-sm md:text-base">{descripcion}</p>
  <div
    class={ticket
      ? "flex justify-end mt-auto"
      : "flex justify-end gap-4 items-center mt-auto"}
  >
    
    <a
      href={linkAnchor} target="_blank"
      aria-label={ticket ? "Solicitar un ticket de soporte técnico" : `Descargar instalador de ${titulo}`}
      class="bg-acento hover:bg-acentoHover text-white px-6 py-3 rounded-full"
      >{ticket ? "Solicitar ticket" : "Descargar"}</a
    >
  </div>
</div>

<style>

  .logo-anydesk {
    height: 2rem;
  }
  
  .logo-teamviewer {
    height: 2.25rem; 
  }
  
 
  @supports (-webkit-touch-callout: none) {
    .logo-anydesk {
      height: 3rem; 
    }
    
    .logo-teamviewer {
      height: 4rem;
    }
  }
</style>
