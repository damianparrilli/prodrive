---
interface Props {
  channelId: string;
  width?: number;
  height?: number;
}

const { channelId, width = 800, height = 450 } = Astro.props as Props;
---

<div class="youtube-container" data-channel-id={channelId}>
  <p class="youtube-loading">Cargando último video...</p>
</div>

<script>
  async function loadLatestVideo() {
    const container = document.querySelector('.youtube-container');
    const channelId = container?.getAttribute('data-channel-id');
    
    if (!channelId) return;

    try {
      const rssUrl = `https://www.youtube.com/feeds/videos.xml?channel_id=${channelId}`;
      const apiUrl = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(rssUrl)}`;

      const response = await fetch(apiUrl);
      const data = await response.json();

      if (data.status === 'ok' && data.items.length > 0) {
        const videoLink = data.items[0].link;
        const match = videoLink.match(/v=([^&]+)/);
        const videoId = match ? match[1] : '';

        if (videoId && container) {
          container.innerHTML = `
            <iframe
              src="https://www.youtube.com/embed/${videoId}?rel=0"
              width="100%"
              height="100%"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          `;
        }
      } else {
        throw new Error("No se encontraron videos");
      }
    } catch (error) {
      if (container) {
        container.innerHTML = '<p class="youtube-loading">Error al cargar el video</p>';
      }
    }
  }

  loadLatestVideo();
</script>

<style>
  .youtube-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto 100px auto;
    aspect-ratio: 16 / 9;
    background: #000;
    position: relative;
  }

  .youtube-container iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .youtube-loading {
    color: #fff;
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 1200px) and (min-width: 768px) {
    .youtube-container {
      margin: 0 20px 100px 20px;
    }
  }

  @media (max-width: 767px) {
    .youtube-container {
      margin: 0 0 100px 0;
      max-width: 100%;
    }
  }
</style>