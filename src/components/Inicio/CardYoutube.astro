---
interface Props {
  channelId: string;
  channelName: string;
  avatarUrl: string;
}

const { channelId, channelName, avatarUrl } = Astro.props as Props;
---

<div class="yt-header-card">
  <div class="yt-header-left">
    <div class="yt-header-avatar">
      <img src={avatarUrl} alt={channelName} loading="lazy" />
    </div>
    <div class="yt-header-info">
      <div class="yt-header-name">{channelName}</div>
    </div>
  </div>

  <div class="yt-header-actions">
    <div
      class="g-ytsubscribe"
      data-channelid={channelId}
      data-layout="default"
      data-theme="dark"
      data-count="hidden"
    ></div>
  </div>
</div>

<script src="https://apis.google.com/js/platform.js" async defer></script>

<style>
  .yt-header-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    border: 1px solid #e5e5e5;
    background: #fff;
    max-width: 420px;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  .yt-header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .yt-header-avatar {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 2px solid #ff0000;
    overflow: hidden;
  }
  .yt-header-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .yt-header-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: #111;
  }
  .yt-header-actions {
    display: flex;
    align-items: center;
  }
</style>
