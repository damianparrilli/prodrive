<section id="quienes-somos-banner" class="banner py-50 w-full bg-center bg-size-[45%] bg-no-repeat bg-contact relative overflow-hidden">
    <canvas id="quienes-canvas" class="absolute top-0 left-0 w-full h-full -z-10"></canvas>
    <div class="contenedor flex flex-col justify-center items-center h-full gap-2 relative z-10">
        <h1 class="text-4xl md:text-5xl mb-4 text-center">Nuestra historia</h1>
        <div id="typing-container" class="text-lg md:text-xl max-w-[1000px] relative text-left w-full">
            <div id="typing-hidden" class="invisible space-y-4" aria-hidden="true">
                <p>Prodrive nace en 1999 como un proyecto orientado a brindar soluciones tecnológicas para PYMES, adaptadas a las necesidades y particularidades de cada mercado.</p>
                <p>Con la llegada y expansión de Internet, las empresas comenzaron a demandar soluciones informáticas cada vez más complejas. A lo largo de los años fuimos incorporando conocimiento y experiencia, alcanzando en 2010 un salto cualitativo mediante la implementación de proyectos tecnológicos de mayor complejidad.</p>
                <p>En 2013, a través de formación continua y capacitaciones especializadas, nos posicionamos firmemente en sectores industriales, de servicios y organismos gubernamentales. En 2019 desarrollamos procesos internos de gestión avanzados, lo que nos permitió mantener un servicio altamente personalizado sin perder eficiencia.</p>
                <p>Durante el período 2020–2022 acompañamos a nuestros clientes en la digitalización de procesos críticos, fortaleciendo la conectividad y consolidándonos como un socio estratégico en contextos de alta exigencia operativa.</p>
                <p>Actualmente continuamos brindando soluciones tecnológicas con altos niveles de capacidad, disponibilidad y adaptación. Creemos que la tecnología debe estar al servicio de las personas: incorporamos Inteligencia Artificial de forma estratégica, sin despersonalizar el negocio y comprendiendo las necesidades actuales de gestión.</p>
                <p class="font-semibold mt-8 text-center">Nuestra mejor definición:</p>
                <p class="italic text-center">Somos fanáticos de lo que hacemos día a día para que nuestros clientes nos recomienden de forma natural como un aliado de negocio.</p>
            </div>
            
            <div id="typing-visible" class="absolute top-0 left-0 w-full space-y-4">
                <p class="typing-paragraph" data-text="Prodrive nace en 1999 como un proyecto orientado a brindar soluciones tecnológicas para PYMES, adaptadas a las necesidades y particularidades de cada mercado."></p>
                <p class="typing-paragraph" data-text="Con la llegada y expansión de Internet, las empresas comenzaron a demandar soluciones informáticas cada vez más complejas. A lo largo de los años fuimos incorporando conocimiento y experiencia, alcanzando en 2010 un salto cualitativo mediante la implementación de proyectos tecnológicos de mayor complejidad."></p>
                <p class="typing-paragraph" data-text="En 2013, a través de formación continua y capacitaciones especializadas, nos posicionamos firmemente en sectores industriales, de servicios y organismos gubernamentales. En 2019 desarrollamos procesos internos de gestión avanzados, lo que nos permitió mantener un servicio altamente personalizado sin perder eficiencia."></p>
                <p class="typing-paragraph" data-text="Durante el período 2020–2022 acompañamos a nuestros clientes en la digitalización de procesos críticos, fortaleciendo la conectividad y consolidándonos como un socio estratégico en contextos de alta exigencia operativa."></p>
                <p class="typing-paragraph" data-text="Actualmente continuamos brindando soluciones tecnológicas con altos niveles de capacidad, disponibilidad y adaptación. Creemos que la tecnología debe estar al servicio de las personas: incorporamos Inteligencia Artificial de forma estratégica, sin despersonalizar el negocio y comprendiendo las necesidades actuales de gestión."></p>
                <p class="typing-paragraph font-semibold mt-8 text-center" data-text="Nuestra mejor definición:"></p>
                <p class="typing-paragraph italic text-center" data-text="Somos fanáticos de lo que hacemos día a día para que nuestros clientes nos recomienden de forma natural como un aliado de negocio."></p>
            </div>
        </div>
    </div>
</section>

<style>
    .bg-contact {
        background-image: url('/images/bg-contact.png');
    }
    
    .banner::before{
        position: absolute;
        content: "";
        width: 100%;
        height: calc(100% - 70px);
        top: 0;
        z-index: -1;
        background: radial-gradient(ellipse at 0% 80%, transparent 70%, #07304A 120%),radial-gradient(ellipse at 0% 30%, #07304A 0%, transparent 40%);
    }
</style>

<script is:inline>
    let animationId;
    let isTypingComplete = false;
    
    function initQuienesAnimation() {
        const banner = document.getElementById("quienes-somos-banner");
        const canvas = document.getElementById("quienes-canvas");
        const visibleContainer = document.getElementById("typing-visible");
        
        if (!banner || !canvas || !visibleContainer || !window.gsap) return;
        
        const ctx = canvas.getContext("2d");
        const typingParagraphs = Array.from(visibleContainer.querySelectorAll(".typing-paragraph"));
        
        const nodes = [];
        let baseDensityFactor = 12000;
        let width, height, maxNodesCount;
        let leftW, rightW, topY, bottomY;
        isTypingComplete = false;
        
        typingParagraphs.forEach(p => p.textContent = "");

        function isAllowed(x, y) {
          return (
            y < topY ||
            x < leftW ||
            x > rightW ||
            y > bottomY
          );
        }

        class Node {
          constructor() {
            this.randomizePosition();
            this.baseVx = (Math.random() - 0.5) * 0.1;
            this.baseVy = (Math.random() - 0.5) * 0.1;
            this.vx = this.baseVx;
            this.vy = this.baseVy;
            this.radius = 2 + Math.random() * 2;
            this.opacity = 0;
            this.targetOpacity = 0.2 + Math.random() * 0.3;
          }

          randomizePosition() {
            let x, y;
            let attempts = 0;
            do {
              x = Math.random() * width;
              y = Math.random() * height;
              attempts++;
              if (attempts > 100) break;
            } while (!isAllowed(x, y));
            this.x = x;
            this.y = y;
          }

          update() {
            this.vx += (this.baseVx - this.vx) * 0.05;
            this.vy += (this.baseVy - this.vy) * 0.05;

            this.x += this.vx;
            this.y += this.vy;

            if (this.x < 0 || this.x > width) this.vx *= -1;
            if (this.y < 0 || this.y > height) this.vy *= -1;

            if (!isAllowed(this.x, this.y)) {
              this.randomizePosition();
            }

            if (this.opacity < this.targetOpacity) {
              this.opacity += 0.02;
            }
          }

          draw() {
            if (this.opacity > 0) {
              ctx.beginPath();
              ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
              ctx.fillStyle = `rgba(255,255,255,${this.opacity})`;
              ctx.fill();
            }
          }
        }

        function resize() {
          const rect = banner.getBoundingClientRect();
          width = canvas.width = rect.width;
          height = canvas.height = rect.height;

          const isMobile = window.innerWidth < 768;
          
          if (isMobile) {
            leftW = width * 0.10;
            rightW = width * 0.90;
            topY = height * 0.25;
            bottomY = height * 0.75;
          } else {
            leftW = width * 0.20;
            rightW = width * 0.80;
            topY = height * 0.20;
            bottomY = height * 0.80;
          }

          const factor = isMobile ? baseDensityFactor * 1.3 : baseDensityFactor;
          maxNodesCount = Math.floor((width * height) / factor);
        }

        function animate() {
          ctx.clearRect(0, 0, width, height);

          nodes.forEach((n) => {
            n.update();
            n.draw();
          });

          animationId = requestAnimationFrame(animate);
        }

        const resizeHandler = () => {
          resize();
          if (isTypingComplete && nodes.length < maxNodesCount) {
            while (nodes.length < maxNodesCount) {
              nodes.push(new Node());
            }
          }
        };

        window.addEventListener("resize", resizeHandler);
        resize();
        
        requestAnimationFrame(() => {
          animate();
          
          setTimeout(() => {
            const totalText = typingParagraphs.map(p => p.getAttribute("data-text")).join("");
            const totalChars = totalText.length;
            let lastNodeCount = 0;
            let charsSoFar = 0;
            
            const timeline = gsap.timeline();
            
            typingParagraphs.forEach((paragraph, index) => {
              const text = paragraph.getAttribute("data-text");
              const chars = text.split("");
              const charsBeforeThis = charsSoFar;
              charsSoFar += chars.length;
              
              timeline.to({ i: 0 }, {
                i: chars.length,
                duration: chars.length * 0.01,
                ease: "none",
                onUpdate: function() {
                  const i = Math.floor(this.targets()[0].i);
                  paragraph.textContent = chars.slice(0, i).join("");
                  
                  const totalProgress = (charsBeforeThis + i) / totalChars;
                  const targetNodeCount = Math.floor(maxNodesCount * totalProgress);
                  
                  if (targetNodeCount > lastNodeCount) {
                    const nodesToAdd = targetNodeCount - lastNodeCount;
                    for (let j = 0; j < nodesToAdd; j++) {
                      nodes.push(new Node());
                    }
                    lastNodeCount = targetNodeCount;
                  }
                },
                onComplete: () => {
                  if (index === typingParagraphs.length - 1) {
                    isTypingComplete = true;
                    while (nodes.length < maxNodesCount) {
                      nodes.push(new Node());
                    }
                  }
                }
              }, index === 0 ? "+=0" : "+=0.1"); 
            });
          }, 300);
        });
        
        return () => {
            cancelAnimationFrame(animationId);
            window.removeEventListener("resize", resizeHandler);
            gsap.killTweensOf({});
        };
    }
    
    let cleanup = initQuienesAnimation();
    
    document.addEventListener('astro:before-preparation', () => {
        if (cleanup) cleanup();
    });
    
    document.addEventListener('astro:page-load', () => {
        cleanup = initQuienesAnimation();
    });
</script>