---
import CardNumeraciones from "../CardNumeraciones.astro";
import { Image } from "astro:assets";

import kaizenMobileImg from "../../../assets/images/kaizen-mobile.webp";
import imagenContableImg from "../../../assets/images/imagen-contable.webp";
import capacitacionesImagenImg from "../../../assets/images/capacitaciones-imagen.webp";
import gestionIAImage from "../../../assets/images/gestion-de-ia.jpg";
---

<div class="servicios-content contenedor text-left flex flex-col overflow-x-hidden">
  <div class="flex flex-col">
    
    
    
    <div id="kaizen-y-5s" class="seccion-contenido flex flex-col w-full gap-4 pt-22 ">
      <div class="flex flex-col">
        <h3 class="text-2xl md:text-3xl">Kaizen y 5S: Mejora continua</h3>
        <p class="text-base md:text-lg">
          Convierta su empresa en un espacio más productivo y competitivo
        </p>
      </div>
      <div class="flex flex-col md:flex-row gap-4 w-full">
        <div
          class="flex flex-col p-6 gap-1 bg-[#1E1C2C] w-full rounded-2xl brillo-hover"
        >
          <h4 class="text-lg md:text-xl">¿Qué hacemos?</h4>
          <ul class="list-disc pl-4">
            <li>
              Implementamos Kaizen para mejorar procesos y fomentar la
              participación del equipo.
            </li>
            <li>
              Aplicamos 5S para organizar, estandarizar y mantener el lugar de
              trabajo seguro y eficiente.
            </li>
          </ul>
        </div>
        <div
          class="flex flex-col p-6 gap-1 bg-[#1E1C2C] w-full rounded-2xl brillo-hover"
        >
          <h4 class="text-lg md:text-xl">Beneficios clave</h4>
          <ul class="list-disc pl-4">
            <li>Procesos más ágiles y eficientes.</li>
            <li>Reducción de desperdicios y costos.</li>
            <li>Mayor seguridad y orden en el trabajo.</li>
            <li>Mejor calidad en productos y servicios.</li>
          </ul>
        </div>
        <div
          class="flex flex-col p-6 gap-1 bg-[#1E1C2C] w-full rounded-2xl brillo-hover"
        >
          <h4 class="text-lg md:text-xl">Nuestro servicio incluye:</h4>
          <ul class="list-disc pl-4">
            <li>Diagnóstico inicial.</li>
            <li>Implementación de mejoras y 5S.</li>
            <li>Seguimiento y ajustes continuos.</li>
          </ul>
        </div>
      </div>
      <div class="flex overflow-hidden rounded-2xl max-h-96">
        <Image
          src={kaizenMobileImg}
          alt=`Imagen de Kaizen`
          width={1500}
          height={1500}
          class="object-cover w-full h-full max-h-96"
          loading="eager"
          decoding="async"
          format="webp"
        />
      </div>
    </div>
    <a href="mailto:soporte@prodrive.com.ar?subject=Consulta%20desde%20la%20web&body=Hola,%20vengo%20de%20la%20web%20de%20ProDrive,%20quisiera%20tener%20m%C3%A1s%20informaci%C3%B3n%20del%20servicio%20Kaizen%20y%205S:%20Mejora%20continua." target="_blank" class="mt-6 mb-12 inline-block px-8 py-3 bg-acento text-white rounded-full hover:bg-acentoHover md:text-lg max-w-max mx-auto text-center">Solicitar Kaizen y 5S: Mejora continua</a>
    
    <div
      id="soporte-tecnico"
      class="seccion-contenido flex gap-6 flex-col md:flex-row items-stretch pt-18 md:pt-22 "
    >
      <div class="flex flex-col gap-4 lg:w-3/5">
        <div class="flex flex-col">
          <h3 class="text-2xl md:text-3xl">Consultoría en Soluciones con Inteligencia Artificial</h3>
          <p class="text-base md:text-lg">
            Diseño e implementación de soluciones basadas en Inteligencia Artificial para resolver problemáticas complejas de negocio.
          </p>
          <div
            class="lg:hidden flex overflow-hidden rounded-2xl mt-4 lg:w-2/5 max-h-50 md:max-h-64"
          >
            <Image
              src={gestionIAImage}
              alt=`Imagen de Gestion de IA Mobile`
              width={1500}
              height={1500}
              class="object-cover w-full h-full max-h-50 md:max-h-64"
              loading="eager"
              decoding="async"
              format="webp"
            />
          </div>
        </div>
        <div class="flex flex-col gap-4 w-full">
          <div
            class="flex flex-col p-6 gap-1 bg-[#1E1C2C] w-full rounded-2xl brillo-hover"
          >
            <p class="text-sm md:text-base">
              Aplicamos IA de manera estratégica en entornos industriales, seguridad física y sistemas informáticos de gestión, optimizando procesos, 
mejorando la toma de decisiones y aumentando la eficiencia operativa.
            </p>
          </div>
          <div
            class="flex flex-col p-6 gap-1 bg-[#1E1C2C] w-full rounded-2xl brillo-hover"
          >
            <p class="text-sm md:text-base">
              Nuestro enfoque combina análisis técnico, conocimiento del negocio y tecnologías avanzadas para lograr reducciones concretas de costos, 
ahorro de tiempo y mayor control sobre la operación. 
            </p>
          </div>
          <div
            class="flex flex-col p-6 gap-1 bg-[#1E1C2C] w-full rounded-2xl brillo-hover"
          >
            <p class="text-sm md:text-base">
              Acompañamos a nuestros clientes desde la consultoría inicial hasta la implementación y soporte de cada solución.

            </p>
          </div>
        </div>
      </div>
      <div class="hidden lg:flex overflow-hidden rounded-2xl lg:w-2/5 xl:w-1/2">
        <Image
          src={gestionIAImage}
          alt=`Imagen de Gestiín de IA`
          width={1500}
          height={1500}
          class="object-cover w-full h-full"
          loading="eager"
          decoding="async"
          format="webp"
        />
      </div>
    </div>
    <a href="mailto:soporte@prodrive.com.ar?subject=Consulta%20desde%20la%20web&body=Hola,%20vengo%20de%20la%20web%20de%20ProDrive,%20quisiera%20tener%20m%C3%A1s%20informaci%C3%B3n%20del%20servicio%20Consultor%C3%ADa%20en%20Soluciones%20con%20Inteligencia%20Artificial." target="_blank" class="mt-6 mb-12 inline-block px-8 py-3 bg-acento text-white rounded-full hover:bg-acentoHover md:text-lg max-w-max mx-auto text-center">Solicitar Gestion de IA</a>
    
    
    <div
      id="asesoramiento-contable-y-administrativo"
      class="seccion-contenido flex flex-col md:flex-row md:items-center gap-4 pt-18 md:pt-22 "
    >
      <div
        class="flex overflow-hidden order-2 md:order-1 w-full md:w-2/5 rounded-2xl h-64"
      >
        <Image
          src={imagenContableImg}
          alt=`Imagen de Kaizen`
          width={1500}
          height={1500}
          class="object-cover w-full h-64"
          loading="eager"
          decoding="async"
          format="webp"
        />
      </div>
      <div class="flex flex-col order-1 md:order-2 w-full md:w-3/5 gap-1">
        <h3 class="text-2xl md:text-3xl">Asesoramiento Contable y Administrativo</h3>
        <p class="text-base md:text-lg">
          Nuestros colaboradores en las distintas áreas podrán evaluar cada uno
          de los requerimientos y brindarle una solución acorde a su negocio y
          necesidades de desarrollo, en relación a temas contables y
          administrativos en general.
        </p>
      </div>
    </div>
    <a href="mailto:soporte@prodrive.com.ar?subject=Consulta%20desde%20la%20web&body=Hola,%20vengo%20de%20la%20web%20de%20ProDrive,%20quisiera%20tener%20m%C3%A1s%20informaci%C3%B3n%20del%20servicio%20Asesoramiento%20Contable%20y%20Administrativo." target="_blank" class="mt-6 mb-12 inline-block px-8 py-3 bg-acento text-white rounded-full hover:bg-acentoHover md:text-lg max-w-max mx-auto text-center">Solicitar Asesoramiento Contable y Administrativo</a>
    
    
    
    
    <div id="capacitaciones" class="seccion-contenido flex flex-col gap-4 pt-18 md:pt-22 ">
      <div class="flex flex-col w-full gap-1">
        <h3 class="text-2xl md:text-3xl">Capacitaciones</h3>
        <p class="text-base md:text-lg">
          Brindamos capacitaciones especializadas en ciberseguridad, uso eficiente de software y buenas prácticas informáticas, orientadas a reducir riesgos,
 proteger la información y optimizar el trabajo diario de los equipos. 
Nuestros programas combinan conceptos técnicos y casos reales, adaptándose al nivel y a las necesidades de cada organización.

        </p>
      </div>
      <div class="flex overflow-hidden w-full rounded-2xl max-h-96">
        <Image
          src={capacitacionesImagenImg}
          alt=`Imagen de Capacitaciones`
          width={1500}
          height={1500}
          class="object-cover w-full max-h-96"
          loading="eager"
          decoding="async"
          format="webp"
        />
      </div>
      <div class="overflow-x-auto md:mx-0 md:px-0 scrollbar-hide">
        <div
          class="flex w-full md:grid md:grid-cols-2 gap-x-4 gap-y-8 mt-6 overflow-y-hidden md:overflow-hidden"
        >
          <CardNumeraciones
            numero="1"
            titulo="5S y orden en el trabajo"
            descripcion="Mejoramos la organización para lograr entornos más eficientes y productivos."
          />
          <CardNumeraciones
            numero="2"
            titulo="Kaizen y mejora continua"
            descripcion="Impulsamos una cultura de mejora constante en los procesos de la empresa."
          />
          <CardNumeraciones
            numero="3"
            titulo="Ciberseguridad para usuarios"
            descripcion="Reducimos riesgos a través de buenas prácticas y concientización del personal."
          />
          <CardNumeraciones
            numero="4"
            titulo="Gestión inteligente de la información"
            descripcion="Ayudamos a ordenar, proteger y aprovechar mejor los datos del negocio."
          />
          <CardNumeraciones
            numero="5"
            titulo="Uso eficiente de herramientas digitales"
            descripcion="Optimizamos el uso del software para ahorrar tiempo y reducir errores."
          />
          <CardNumeraciones
            numero="6"
            titulo="Prevención de pérdida de información"
            descripcion="Implementamos prácticas que aseguran la continuidad y resguardo de los datos."
          />
          <CardNumeraciones
            numero="7"
            titulo="Adopción práctica de Inteligencia Artificial"
            descripcion="Incorporamos IA de forma simple para automatizar tareas y mejorar resultados."
          />
          <CardNumeraciones
            numero="8"
            titulo="Optimización de procesos y eficiencia operativa"
            descripcion="Detectamos oportunidades de mejora para reducir costos y aumentar productividad"
          />
        </div>
      </div>
    </div>
    <a href="mailto:soporte@prodrive.com.ar?subject=Consulta%20desde%20la%20web&body=Hola,%20vengo%20de%20la%20web%20de%20ProDrive,%20quisiera%20tener%20m%C3%A1s%20informaci%C3%B3n%20del%20servicio%20Capacitaciones." target="_blank" class="mt-6 mb-12 inline-block px-8 py-3 bg-acento text-white rounded-full hover:bg-acentoHover md:text-lg max-w-max mx-auto text-center">Solicitar Capacitaciones</a>



  </div>
</div>
