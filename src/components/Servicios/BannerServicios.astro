---
interface Props{
    titulo: string;
}

const {titulo} = Astro.props;
---

<section class="banner h-96 pt-[70px] w-full relative overflow-hidden">
    <canvas id="banner-canvas" class="absolute inset-0 w-full h-full"></canvas>
    <div class="contenedor flex flex-col justify-center items-center h-full text-center gap-2 relative z-10">
        <h1 class="text-4xl md:text-5xl">{titulo}</h1>
    </div>
</section>

<style>
    .banner {
        position: relative;
    }

    .banner::before {
        position: absolute;
        content: "";
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        z-index: 1;
        background: radial-gradient(ellipse at 0% 80%, transparent 70%, #07304a 120%),
                    radial-gradient(ellipse at 0% 30%, #07304a 0%, transparent 40%);
        pointer-events: none;
    }

    #banner-canvas {
        display: block;
        z-index: 0;
    }
</style>

<script>
    let animationId: number;
    
    function initAnimation() {
        const canvas = document.getElementById('banner-canvas') as HTMLCanvasElement;
        if (!canvas) return;
        
        const ctx = canvas.getContext('2d')!;
        let W = canvas.width = window.innerWidth;
        let H = canvas.height = canvas.offsetHeight;
        const pixels: Array<{x: number, y: number, z: number}> = [];

        for (let x = -400; x < 400; x += 5) {
            for (let z = -250; z < 250; z += 5) {
                pixels.push({x: x, y: 100, z: z});
            }  
        }

        function render(ts: number) {
            const imageData = ctx.getImageData(0, 0, W, H);
            const len = pixels.length;
            const fov = 250;
            
            for (let i = 0; i < len; i++) {
                const pixel = pixels[i];
                const scale = fov / (fov + pixel.z);
                const x2d = -pixel.x * scale + W / 2;
                const y2d = pixel.y * scale + H / 2 + 100;
                
                if(x2d >= 0 && x2d <= W && y2d >= 0 && y2d <= H) {
                    const c = (Math.round(y2d) * imageData.width + Math.round(x2d)) * 4;
                    imageData.data[c] = 52;
                    imageData.data[c + 1] = 82;
                    imageData.data[c + 2] = 235;
                    imageData.data[c + 3] = 255;
                }
                
                pixel.z -= 0.2;
                pixel.y = H / 14 + Math.sin(i / len * 15 + (ts / 450)) * 10;
                if (pixel.z < -fov) pixel.z += 2 * fov;
            }
            
            ctx.putImageData(imageData, 0, 0);
        }

        function drawFrame(ts: number) {
            animationId = requestAnimationFrame(drawFrame);
            ctx.fillStyle = '#0B081D';
            ctx.fillRect(0, 0, W, H);
            render(ts);
        }

        const resizeHandler = () => {
            W = canvas.width = window.innerWidth;
            H = canvas.height = canvas.offsetHeight;
        };
        
        window.addEventListener('resize', resizeHandler);
        drawFrame(0);
        
        return () => {
            cancelAnimationFrame(animationId);
            window.removeEventListener('resize', resizeHandler);
        };
    }
    
    let cleanup = initAnimation();
    
    document.addEventListener('astro:before-preparation', () => {
        if (cleanup) cleanup();
    });
    
    document.addEventListener('astro:page-load', () => {
        cleanup = initAnimation();
    });
</script>